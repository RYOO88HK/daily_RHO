         </div> <!---Top card div-->


         <div class="tab_con_item" data-category="short">
            <a href="/AcademyDetail.html?id=id_s2">
               <img src="/img_run_s/ma_s2.GIF">
               <div class="card_info">
                  <span>클래스명</span>
                  <span>(장소)</span>
                  <span>25-11-27</span>
                  <span>35,000원</span>
               </div> <!---Top card div-->
            </a>
         </div><!--tab_con_item-->


         <div class="tab_con_item" data-category="long">
            <img src="/img_run_s/ma_s3.GIF">
            <div class="card_info">
               <span>클래스명</span>
               <span>(장소)</span>
               <span>25-11-7</span>
               <span>15,000원</span>
            </div> <!---Top card div-->
         </div><!--tab_con_item-->


         <div class="tab_con_item" data-category="oneday">
            <img src="/img_run_s/ma_s4.GIF">
            <div class="card_info">
               <span>클래스명</span>
               <span>(장소)</span>
               <span>25-11-4</span>
               <span>55,000원</span>
            </div> <!---Top card div-->
         </div><!--tab_con_item-->

      </div> <!--tab_xon-->
   </div>

</body>

</html>
<script>
   //탭클릭+ 해당 카테고리만 보이기
   document.querySelectorAll('.tab li').forEach(tab => {
      tab.addEventListener('click', () => {
         const type = tab.dataset.type;

         //디자인 변경

         //    document.querySelectorAll('.tab il').forEach (t=>t.classList.remove('on'));
         //      tab.classList.add('on');

         //카드 필터링
         document.querySelectorAll('.tab_con_item').forEach(item => {
            if (type === item.dataset.category) {
               item.style.display = "block";
            } else {
               item.style.display = "none";
            }
         });
      });
   });

   //모든 카드선택
   document.querySelectorAll('.tab_con_item').forEach(card => {
      card.addEventListener('click', () => {
         const detail = card.querySelector('.card_detail');

         //다른 카드 열려있으면 닫기
         document.querySelectorAll('.card_detail').forEach(dd => {
            if (dd !== detail) dd.style.display = 'none';
         });

         //현재 카드 상세정보 토글
         if (detail.style.display === 'block') {
            detail.style.display = 'none';
         } else {
            detail.style.display = 'block'
         }

      });
   });



   document.querySelectorAll('.tab_con_item').forEach(card => {
      card.style.display = 'block';       // 카드 보이기
      const info = card.querySelector('.card_info');
      if (info) info.style.display = 'flex';
      const img = card.querySelector('img');
      if (img) img.style.display = 'block';

      const detail = card.querySelector('.card_detail');
      if (detail) detail.style.display = 'none';
   });




</script>